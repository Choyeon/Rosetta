# Rosetta Frontend · Nuxt 4 环境变量示例
# ------------------------------------------------------------------
# 浏览器端（客户端）调用后端 API 的地址：
#   · 同源 + Nginx 反代（默认）：/api
#   · 前后端分离跨域时：https://api.example.com/api
API_BASE_URL=/api

# SSR 期 Nitro 直连 FastAPI 的绝对 URL（页面 useFetch / RSS/sitemap/robots 都依赖它）
# 开发期：一般为 http://127.0.0.1:8000/api （与 dev.ps1 / AGENTS.md 后端端口一致）
# 生产部署：根据 FastAPI 实际监听地址填写（内网 IP 优先，不要走公网回环）
NUXT_API_BASE=http://127.0.0.1:8000/api
SSR_API_BASE_URL=http://127.0.0.1:8000/api

# 客户端可见的公开 API 基址（同源部署留 /api）
NUXT_PUBLIC_API_BASE=/api

# Site Configuration
NUXT_PUBLIC_SITE_NAME=Rosetta
NUXT_PUBLIC_SITE_URL=http://localhost:3000
