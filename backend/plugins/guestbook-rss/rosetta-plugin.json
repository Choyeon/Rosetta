{
  "manifest_version": "1.0",
  "id": "io.github.rosetta.guestbook-rss",
  "name": "Guestbook RSS",
  "slug": "guestbook-rss",
  "version": "0.1.0",
  "requires_rosetta": ">=1.0.0",
  "description": "示例插件：为留言板生成独立前台 RSS feed.xml，同时提供独立后台设置页（GET/PUT settings）与侧边栏菜单入口。",
  "author_name": "Rosetta Team",
  "author": {"name":"Rosetta Team", "uri": "https://rosetta.dev"},
  "plugin_uri": "https://rosetta.dev/plugins/guestbook-rss",
  "author_uri": "https://rosetta.dev",
  "textdomain": "guestbook-rss",
  "tags": ["sample", "rss", "guestbook", "admin-page", "public-route"],
  "category": "publishing",
  "entry": "plugin.py",
  "entrypoint": "plugin:register",
  "admin_menu": {
    "slug": "guestbook-rss",
    "label": "留言板 RSS",
    "icon": "material-symbols:rss-feed-rounded",
    "path": "/admin/plugins/guestbook-rss/settings",
    "group": "plugins"
  },
  "public_routes": [
    {"method": "GET", "path": "/feed.xml", "desc": "留言板 RSS 2.0 feed (application/rss+xml)"}
  ],
  "admin_routes": [
    {"method": "GET",  "path": "/settings", "desc": "读取 RSS 设置"},
    {"method": "PUT",  "path": "/settings", "desc": "保存 RSS 设置"}
  ],
  "settings_schema": {
    "$schema": "https://json-schema.org/draft-07/schema",
    "type": "object",
    "properties": {
      "feed_title": {
        "type": "string",
        "title": "RSS 频道标题",
        "default": "Rosetta 留言板 RSS"
      },
      "feed_description": {
        "type": "string",
        "title": "RSS 频道描述",
        "format": "textarea",
        "default": "最近 50 条公开留言"
      },
      "max_items": {
        "type": "integer",
        "title": "最多输出多少条留言",
        "minimum": 1,
        "maximum": 200,
        "default": 50
      },
      "include_author_email": {
        "type": "boolean",
        "title": "在 RSS 中包含作者邮箱（<author>）",
        "default": false
      },
      "language": {
        "type": "string",
        "title": "RSS <language> 标签",
        "enum": ["zh-CN", "zh-TW", "en-US", "ja-JP"],
        "default": "zh-CN"
      }
    }
  },
  "screenshot_urls": [],
  "dependencies": []
}
