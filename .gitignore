# =======================================================
# Rosetta — Git Ignore
# =======================================================

# --- Python cache & build ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
*.manifest
*.spec

# --- Virtual environment ---
.venv/
venv/
ENV/
/lib/
/lib64/

# --- Test / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# --- Python tool caches ---
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/

# --- Database (runtime state) ---
*.sqlite3*
*.db
*.db-*
rosetta.db
rosetta.json
.oobe_complete
.oobe_state.json

# --- Environment & secrets ---
.env
.env.*
!.env.example
.secrets/
*.pem
*.key

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
.pnpm-store/
.pnpm-store*/
.npm-cache/
.pnpm-home/

frontend/.nuxt/
frontend/.output/
frontend/.cache/
frontend/.pnpm-store*/
frontend/.eslintcache
frontend/.dev_server.log

# --- Logs ---
*.log
*.log.*
logs/
npm-debug.log*
pnpm-debug.log*

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
.settings/

# --- Media & uploads (runtime generated) ---
media/
uploads/
frontend/pages/admin/media/

# --- Local tool scratch files ---
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.local
*.pid
*.seed

# --- Vercel / deployment ---
.vercel/
.wrangler/

# --- AI / IDE workspace files ---
.trae/
.clinerules/
.kiro/
.workbuddy/
.backups/
