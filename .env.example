# ============================================================
# Rosetta 环境配置示例
# ============================================================
# 复制此文件为 .env 并根据您的环境修改配置
#
# 环境说明:
# - 开发环境 (development): SQLite + 内存缓存,简单快速启动
# - 生产环境 (production): PostgreSQL + Redis,高性能可扩展
# ============================================================

# ------------------------------------------------------------
# 应用配置
# ------------------------------------------------------------
APP_NAME=Rosetta Blog
APP_ENV=development
DEBUG=true

# ------------------------------------------------------------
# 数据库配置
# ------------------------------------------------------------
# 开发环境: SQLite(默认)
DATABASE_URL=sqlite+aiosqlite:///./rosetta.db

# 生产环境: PostgreSQL(取消注释并修改)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rosetta

# 数据库连接池(仅 PostgreSQL 有效)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ------------------------------------------------------------
# Redis 配置
# ------------------------------------------------------------
# 开发环境: 可不启用 Redis
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# 生产环境: 建议启用 Redis(取消注释)
# REDIS_ENABLED=true
# REDIS_URL=redis://:password@localhost:6379/0

# ------------------------------------------------------------
# JWT 认证配置
# ------------------------------------------------------------
# 生产环境必须更改此密钥!使用 `openssl rand -hex 32` 生成
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# CORS 配置
# ------------------------------------------------------------
# JSON 数组格式,列出允许的前端来源
# 开发环境默认放行所有来源,生产环境必须显式列出
CORS_ORIGINS=["http://localhost:4321", "http://127.0.0.1:4321"]

# ------------------------------------------------------------
# 站点配置
# ------------------------------------------------------------
SITE_NAME=Rosetta Blog
SITE_DESCRIPTION=Rosetta开源博客系统
SITE_KEYWORDS=blog,rosetta,astro,fastapi,svelte
SITE_AUTHOR=Administrator
SITE_EMAIL=admin@example.com
SITE_URL=http://localhost:4321

# ------------------------------------------------------------
# 功能开关
# ------------------------------------------------------------
ENABLE_COMMENTS=true
ENABLE_REGISTRATION=true
ENABLE_RSS_FEED=true

# ------------------------------------------------------------
# 日志配置
# ------------------------------------------------------------
LOG_LEVEL=INFO

# ------------------------------------------------------------
# 文件上传配置
# ------------------------------------------------------------
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=["jpg","jpeg","png","gif","webp","svg","pdf"]

# ------------------------------------------------------------
# 前端 / SSR 配置
# ------------------------------------------------------------
# 浏览器端调用后端 API 的地址（同源部署留 "/api"；前后端分离跨域时写完整域名）
API_BASE_URL=/api

# SSR（Nuxt/Nitro 服务端渲染期）直连 FastAPI 的完整地址：必须绝对 URL，通常与后端监听一致
# 推荐使用 NUXT_ 前缀（Nuxt 4 会直接注入 runtimeConfig）：
NUXT_API_BASE=http://127.0.0.1:8000/api
# 别名（若你的部署规范更偏后端思维，写这个也等价）：
SSR_API_BASE_URL=http://127.0.0.1:8000/api

# 浏览器端暴露给客户端的 API 地址（只在跨域时才写完整 URL）
NUXT_PUBLIC_API_BASE=/api

# 前端对外公开域名（生成 RSS/sitemap/robots/邮件链接用）
NUXT_PUBLIC_SITE_NAME=Rosetta Blog
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# 旧变量名保留，避免升级时静默失效（若已提供上方 NUXT_API_BASE 可留空）
# ROSETTA_API_BASE=http://127.0.0.1:8000/api
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8000

# ------------------------------------------------------------
# 主题切换后的前端页面缓存清除（防"旧主题闪一下"）
#   后端在主题激活/mods 保存/升级后，向 Nuxt 的 POST /_rosetta/purge-cache
#   发一个带密钥请求，清掉 Nitro routeRules 的 SWR 页面缓存。
#   · 开发环境：FRONTEND_BASE_URL 留空即可（自动回退 http://localhost:3000，
#     dev 下清除端点免密钥）。
#   · 生产环境：必须同时配置两侧且密钥一致，否则功能保持关闭：
#       FRONTEND_BASE_URL=Docker 内前端服务地址（如 http://frontend:3000）
#       FRONTEND_PURGE_SECRET = NUXT_PURGE_SECRET（强随机串）
# ------------------------------------------------------------
# FRONTEND_BASE_URL=
# FRONTEND_PURGE_SECRET=
# NUXT_PURGE_SECRET=

# ------------------------------------------------------------
# 管理员初始账号(OOBE 时使用,仅首次创建)
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123456
ADMIN_NICKNAME=Administrator

# ------------------------------------------------------------
# Docker Compose 配置(仅 docker compose 时生效)
# ------------------------------------------------------------
DB_USER=rosetta
DB_PASSWORD=rosetta_secret
DB_NAME=rosetta
DB_PORT=5432
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=80
BACKEND_WORKERS=4
